{
  "clientId": "temporal-ui",
  "name": "Temporal (administration)",
  "description": "Interface Temporal derrière oauth2-proxy. Client confidentiel : le secret est généré par Keycloak (onglet Credentials) et copié dans le Secret temporal-ui-oauth2 de sophia-core.",
  "enabled": true,
  "protocol": "openid-connect",
  "publicClient": false,
  "clientAuthenticatorType": "client-secret",
  "standardFlowEnabled": true,
  "directAccessGrantsEnabled": false,
  "implicitFlowEnabled": false,
  "serviceAccountsEnabled": false,
  "redirectUris": ["https://temporal.apps.example.org/oauth2/callback"],
  "webOrigins": ["https://temporal.apps.example.org"],
  "attributes": {
    "pkce.code.challenge.method": "S256",
    "post.logout.redirect.uris": "https://temporal.apps.example.org/"
  },
  "protocolMappers": [
    {
      "name": "groups",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-group-membership-mapper",
      "config": {
        "claim.name": "groups",
        "full.path": "false",
        "id.token.claim": "true",
        "access.token.claim": "true",
        "userinfo.token.claim": "true"
      }
    }
  ]
}
