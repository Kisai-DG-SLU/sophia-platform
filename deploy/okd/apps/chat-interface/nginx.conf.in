# SophIA - Reverse proxy nginx — TEMPLATE (tracké par git)
#
# Ce fichier est un modèle : il est rendu en `nginx.conf` (gitignoré) par
# `render-config.py`, au lancement (`make serve`) et à chaque rechargement.
# seuls les marqueurs LITELLM_AUTH et LITELLM_AUDIO_AUTH (écrits $ + {…}) sont substitués :
#   - clé présente dans l'env   → `"Bearer sk-..."`
#   - clé absente               → `""` (nginx retire l'en-tête → LiteLLM 401)
#   - clé audio absente         → la clé du pod
#
# Front statique (app) sur le port 8080.
# /api/ → LiteLLM interne, préfixe /api/ strippé, LISTE BLANCHE seulement :
#   /api/v1/chat/completions → http://litellm-svc:4000/v1/chat/completions
#   /api/v1/models, /api/health/liveliness
# En prod, /api/v1/chat/completions passe par l'API des discussions (contexte
# injecté) ; /api/store/ est l'API des discussions et des profils.
# Tout autre /api/… rend 404 : sans cela, n'importe quel client du proxy
# appellerait les routes d'administration de LiteLLM (/key/*, /user/*,
# /model/*…) avec l'identité du pod.
# proxy_buffering off : streaming SSE proxyé en direct.
#
# Identité LiteLLM : injectée par OKD dans l'environnement du conteneur
# (secretKeyRef → dev-secret-sophia-interface/LITELLM_API_KEY). Le navigateur ne détient AUCUN
# secret — nginx est le seul client authentifié auprès de LiteLLM.
# Le secret n'est JAMAIS écrit ici ni dans un autre fichier tracké : il est
# injecté uniquement au moment du rendu, dans `nginx.conf` (mode 600).

worker_processes 1;

error_log /mnt/prod/deploy/logs/error.log warn;
pid /mnt/prod/deploy/logs/nginx.pid;

events {
    worker_connections 128;
}

http {
    include       /mnt/prod/.pixi/envs/default/etc/nginx/mime.types;
    default_type  application/octet-stream;

    access_log /mnt/prod/deploy/logs/access.log;

    # Corps de requête : longues conversations, résultats de recherche. Au-delà du tampon,
    # nginx écrit dans un fichier temporaire : chemins explicites dans deploy/logs (accessible
    # en écriture en dev comme en prod), sinon le nginx de pixi répond 500.
    client_body_buffer_size 128k;
    client_body_temp_path /mnt/prod/deploy/logs/tmp-body;
    proxy_temp_path /mnt/prod/deploy/logs/tmp-proxy;

    sendfile on;
    keepalive_timeout 65;
    gzip on;

    # Identité de l'utilisateur pour LiteLLM (dépenses par personne) : en prod,
    # oauth2-proxy place l'utilisateur Keycloak dans X-Forwarded-*. En dev, sans
    # proxy, la valeur est vide et l'en-tête n'est pas envoyé.
    map $http_x_forwarded_preferred_username $sophia_end_user {
        ""      $http_x_forwarded_email;
        default $http_x_forwarded_preferred_username;
    }

    # API des discussions et des profils (étapes 6b, 5c), conteneur voisin du pod.
    # Origine de l'école sur sa propre adresse : la seule à recevoir les en-têtes CORS.
    map $http_origin $ecole_origin {
        "https://ecole.example.org" $http_origin;
        default "";
    }
    map $ecole_origin $ecole_credentials {
        "" "";
        default "true";
    }

    upstream sophia_store {
        server 127.0.0.1:8000;
        keepalive 8;
    }

    # Discussions : en prod (identité présente), elles passent par l'API, qui
    # injecte persona, profil et date avant LiteLLM. En dev, directement LiteLLM.
    map $sophia_end_user $sophia_chat_upstream {
        ""      litellm;
        default sophia_store;
    }

    # Jeton d'accès de la personne, seulement quand la discussion passe par l'API (identité présente).
    map $sophia_end_user $sophia_jeton {
        ""      "";
        default $http_x_forwarded_access_token;
    }

    upstream litellm {
        server litellm-svc.sophia-core.svc.cluster.local:4000;
        keepalive 16;
    }

    server {
        listen 8080;
        server_name _;

        root /mnt/prod;
        index index.html;

        client_max_body_size 20m;

        # root est le dépôt entier : .git/, deploy/nginx.conf (rendu, il contient
        # la clé LiteLLM), deploy/logs/… Seuls les fichiers du front sont servis,
        # tout le reste rend 404. Un nouveau dossier du front s'ajoute ici.
        # Cache : le navigateur revalide la page et les scripts à chaque chargement (réponse
        # 304 si rien n'a changé). Sans en-tête, Safari les garde des jours après une mise à
        # jour (cache heuristique) : un correctif déployé restait invisible sur une tablette.
        location = / {
            add_header Cache-Control "no-cache";
            try_files /index.html =404;
        }
        location = /index.html { add_header Cache-Control "no-cache"; }
        location = /models.js { add_header Cache-Control "no-cache"; }
        location = /pricing.json { add_header Cache-Control "no-store"; }
        location ^~ /css/ { add_header Cache-Control "no-cache"; }
        location ^~ /js/ { add_header Cache-Control "no-cache"; }
        location ^~ /images/ { add_header Cache-Control "max-age=86400"; }
        # Polices des thèmes, embarquées : jamais changées sous le même nom.
        location ^~ /fonts/ { add_header Cache-Control "max-age=2592000"; }
        # Bibliothèques embarquées (vendor/README.md) : la version est dans le chemin, le fichier ne change jamais.
        location ^~ /vendor/ { add_header Cache-Control "max-age=2592000"; }

        location / {
            return 404;
        }

        # Sophia School a sa propre adresse : /ecole/ n'est plus relayée. Une redirection 302 (et non
        # 301, mise en cache pour toujours) sert les marque-pages et les boutons des anciennes réponses ; le
        # navigateur garde le fragment (#/salle/…). Les avatars ne passent plus par ici : l'API lit le catalogue
        # au Service de l'école. À retirer à un nettoyage suivant.
        location = /ecole {
            return 302 https://ecole.example.org/;
        }
        location ^~ /ecole/ {
            return 302 https://ecole.example.org/;
        }

        # Routes LiteLLM réellement appelées par le front (js/api.js).
        # Ajouter une route ici, jamais élargir à tout /api/.
        location = /api/v1/chat/completions {
            rewrite ^/api/(.*)$ /$1 break;
            proxy_pass http://$sophia_chat_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host litellm-svc.sophia-core.svc.cluster.local:4000;
            proxy_set_header Connection "";
            # Jeton d'accès de la personne (oauth2-proxy --pass-access-token) : vers store-api seulement, et sur
            # cette seule route ; jamais vers LiteLLM (pod de dev sans identité : vide).
            proxy_set_header X-Forwarded-Access-Token "";
            proxy_set_header X-Sophia-Jeton $sophia_jeton;
            proxy_set_header Authorization ${LITELLM_AUTH};
            proxy_set_header x-litellm-customer-id "";
            proxy_set_header x-litellm-end-user-id $sophia_end_user;
            proxy_set_header X-Sophia-User $sophia_end_user;
            proxy_set_header X-Sophia-Groups $http_x_forwarded_groups;
            proxy_buffering off;
            proxy_cache off;
            proxy_connect_timeout 10s;
            proxy_send_timeout 300s;
            proxy_read_timeout 300s;
        }

        # Voix locale : sophia-stt et sophia-tts, via LiteLLM (clé et identité imposées). Clé dédiée
        # (LITELLM_AUDIO_API_KEY, render-config.py) limitée aux modèles audio : le modèle du formulaire ne
        # peut pas viser un modèle distant.
        # Corps limités : 12 Mo pour un enregistrement (le service refuse au-delà de 10 Mo / 120 s).
        location ~ ^/api/v1/audio/(transcriptions|speech)$ {
            rewrite ^/api/(.*)$ /$1 break;
            proxy_pass http://litellm;
            proxy_http_version 1.1;
            proxy_set_header Host litellm-svc.sophia-core.svc.cluster.local:4000;
            proxy_set_header Connection "";
            proxy_set_header X-Forwarded-Access-Token "";
            proxy_set_header X-Sophia-Jeton "";
            proxy_set_header Authorization ${LITELLM_AUDIO_AUTH};
            proxy_set_header x-litellm-customer-id "";
            proxy_set_header x-litellm-end-user-id $sophia_end_user;
            client_max_body_size 12m;
            proxy_request_buffering on;
            proxy_connect_timeout 10s;
            proxy_send_timeout 120s;
            proxy_read_timeout 120s;
        }

        location ~ ^/api/(v1/models|health/liveliness)$ {
            rewrite ^/api/(.*)$ /$1 break;
            proxy_pass http://litellm;
            proxy_http_version 1.1;

            proxy_set_header Host litellm-svc.sophia-core.svc.cluster.local:4000;
            proxy_set_header Connection "";
            proxy_set_header X-Forwarded-Access-Token "";
            proxy_set_header X-Sophia-Jeton "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

            # LiteLLM est transparent pour le navigateur : le proxy EST le client
            # authentifié. L'en-tête reçu d'un éventuel client tiers est
            # systématiquement écrasé par l'identité du pod (env OKD).
            proxy_set_header Authorization ${LITELLM_AUTH};

            # LiteLLM lit toujours ces deux en-têtes (STANDARD_CUSTOMER_ID_HEADERS) :
            # jamais ceux du client, seulement l'identité posée par oauth2-proxy.
            proxy_set_header x-litellm-customer-id "";
            proxy_set_header x-litellm-end-user-id $sophia_end_user;

            proxy_buffering off;
            proxy_cache off;
            chunked_transfer_encoding on;

            proxy_connect_timeout 10s;
            proxy_send_timeout 300s;
            proxy_read_timeout 300s;
        }

        # API des discussions (étape 6b), conteneur voisin dans le pod. Identité
        # imposée : celle d'oauth2-proxy, jamais celle du client. Sans identité
        # (pod de dev, sans proxy), 404 : le front reste sur IndexedDB.
        location ^~ /api/store/ {
            if ($sophia_end_user = "") {
                return 404;
            }
            # Routes de l'école : l'école, sur sa propre adresse, n'appelle le chat que sous ce
            # préfixe. CORS pour la seule origine exacte de l'école ($ecole_origin), avec le cookie du chat.
            # Préflight OPTIONS (sans cookie, laissé passer par oauth2-proxy) traité ici, avant l'identité.
            # Les directives if/return ne s'héritent pas d'un bloc à l'autre : chaque bloc les répète.
            location ^~ /api/store/school/ {
                if ($request_method = OPTIONS) {
                    return 204;
                }
                if ($sophia_end_user = "") {
                    return 404;
                }
                add_header Access-Control-Allow-Origin $ecole_origin always;
                add_header Access-Control-Allow-Credentials $ecole_credentials always;
                add_header Access-Control-Allow-Methods "GET, POST, PUT" always;
                add_header Access-Control-Allow-Headers "Content-Type" always;
                add_header Access-Control-Max-Age 600 always;
                add_header Vary Origin always;
                # Appels de l'école au modèle local (ardoise, fiche de lecture, « Demander à Sophia », réaction
                # à une note) : même API, plus la clé LiteLLM du pod ; corps de 2 photos, lecture jusqu'à 3 min.
                location ~ "^/api/store/school/(ardoise|lecture|aide|reaction/[0-9a-f-]{36})$" {
                    if ($request_method = OPTIONS) {
                        return 204;
                    }
                    if ($sophia_end_user = "") {
                        return 404;
                    }
                    limit_except POST OPTIONS { deny all; }
                    proxy_pass http://127.0.0.1:8000;
                    proxy_http_version 1.1;
                    proxy_set_header Connection "";
                    proxy_set_header X-Forwarded-Access-Token "";
                    proxy_set_header X-Sophia-Jeton "";
                    proxy_set_header X-Sophia-User $sophia_end_user;
                    proxy_set_header X-Sophia-Groups $http_x_forwarded_groups;
                    proxy_set_header Authorization ${LITELLM_AUTH};
                    client_max_body_size 9m;
                    proxy_read_timeout 180s;
                }
                # Voix de Sophia pour l'école : clé audio (modèles audio locaux seulement).
                location = /api/store/school/voix {
                    if ($request_method = OPTIONS) {
                        return 204;
                    }
                    if ($sophia_end_user = "") {
                        return 404;
                    }
                    limit_except POST OPTIONS { deny all; }
                    proxy_pass http://127.0.0.1:8000;
                    proxy_http_version 1.1;
                    proxy_set_header Connection "";
                    proxy_set_header X-Forwarded-Access-Token "";
                    proxy_set_header X-Sophia-Jeton "";
                    proxy_set_header X-Sophia-User $sophia_end_user;
                    proxy_set_header X-Sophia-Groups $http_x_forwarded_groups;
                    proxy_set_header Authorization ${LITELLM_AUDIO_AUTH};
                    proxy_read_timeout 120s;
                }
                proxy_pass http://127.0.0.1:8000;
                proxy_http_version 1.1;
                proxy_set_header Connection "";
                proxy_set_header X-Forwarded-Access-Token "";
                proxy_set_header X-Sophia-Jeton "";
                proxy_set_header X-Sophia-User $sophia_end_user;
                proxy_set_header X-Sophia-Groups $http_x_forwarded_groups;
                proxy_read_timeout 60s;
            }
            # « Quoi de neuf ? » : l'API appelle les routes de résumé des applications avec le jeton de la
            # personne ; elle le reçoit ici comme sur la discussion, et sur aucune autre route du store.
            location = /api/store/quoi-de-neuf {
                if ($sophia_end_user = "") {
                    return 404;
                }
                proxy_pass http://127.0.0.1:8000;
                proxy_http_version 1.1;
                proxy_set_header Connection "";
                proxy_set_header X-Forwarded-Access-Token "";
                proxy_set_header X-Sophia-Jeton $sophia_jeton;
                proxy_set_header X-Sophia-User $sophia_end_user;
                proxy_set_header X-Sophia-Groups $http_x_forwarded_groups;
                proxy_read_timeout 30s;
            }
            proxy_pass http://127.0.0.1:8000;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header X-Forwarded-Access-Token "";
            proxy_set_header X-Sophia-Jeton "";
            proxy_set_header X-Sophia-User $sophia_end_user;
            proxy_set_header X-Sophia-Groups $http_x_forwarded_groups;
            proxy_read_timeout 60s;
        }

        location /api/ {
            return 404;
        }
    }
}